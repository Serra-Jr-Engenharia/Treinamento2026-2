generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model room {
  id      Int   @id @default(autoincrement())
  quartos Int
  preco   Float
}

model user{
  id      Int       @id @default(autoincrement())
  Nome    String    @unique
  senha   String
  
}