generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
    url      = env("DATABASE_URL")
}

model room {
  id      Int   @id @default(autoincrement())
  quartos Int
  preco   Float
}

model user{
  id      Int       @id @default(autoincrement())
  Nome    String    @unique
  senha   String
  
}